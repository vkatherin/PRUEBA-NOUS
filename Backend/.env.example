# ── Base de datos ────────────────────────────────
# Usa postgres para Supabase. El esquema debe existir previamente en Supabase.
DB_CLIENT=mysql
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require
DB_HOST=127.0.0.1
DB_NAME=nous_db
DB_USER=root
DB_PASSWORD=TU_PASSWORD_AQUI
DB_PORT=3306
PORT=4200

# ── Auth ──────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# ── Google OAuth 2.0 ──────────────────────────────
# Obtén estas credenciales en https://console.cloud.google.com
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID_AQUI
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET_AQUI
GOOGLE_CALLBACK_URL=http://localhost:4200/api/auth/google/callback

# ── Dominio institucional ─────────────────────────
DOMINIO_INSTITUCIONAL=unicatolicadelsur.edu.co

# ── URL del frontend ──────────────────────────────
FRONTEND_URL=http://localhost:5173

